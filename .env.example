TELEMETRY_BASE_URL=https://register.axiooworld.com
TELEMETRY_USER_ID=replace-with-real-user-id
TELEMETRY_API_KEY=replace-with-real-api-key
TELEMETRY_TASK_NAME=TelemetryServiceActivation
# Optional: preferred public-IP lookup endpoint, expected to return the client IP
# as plain text. When unset or empty, only the ipify fallback is used.
# TELEMETRY_IP_PUBLIC_URL=https://ip.example.com/ip
# Optional feature flags for extra payload fields. Both are DISABLED by default.
# Set to any value (e.g. 1) to include the field in the activation request.
# TELEMETRY_SEND_IP_PUBLIC=1
# TELEMETRY_SEND_LOGS=1
# Optional build-time debug toggle. When enabled, the agent keeps durable JSON
# activation state (install id, attempt counters) and writes logs to
# %ProgramData%\TelemetryService\logs\activation.log. Leave unset for production.
# TELEMETRY_DEBUG=1
# Optional block zone: while the device is within radius of the center, all POSTs are suppressed.
# Leave unset to disable. All three values are required when enabled.
# TELEMETRY_BLOCK_LATITUDE=-6.177893340970498
# TELEMETRY_BLOCK_LONGITUDE=106.93924105078182
# TELEMETRY_BLOCK_RADIUS_METERS=1000